# Use a URL-safe password (letters, digits, - _ .) because it is embedded in DATABASE_URL
POSTGRES_PASSWORD=change-me

# Optional overrides; every key also has a default in configs/default.go
PORT=8080
CONFIG_FILE=configs/dev.config.yaml
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_READ_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=90s
SERVER_MAX_HEADER_BYTES=16384
SERVER_SHUTDOWN_TIMEOUT=8s
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
